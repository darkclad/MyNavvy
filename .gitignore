# Android / Gradle build output
*.iml
.gradle/
.kotlin/
build/
/captures
.externalNativeBuild
.cxx
local.properties
/.idea
.DS_Store

# Maps & generated chart data — large, not source (regenerated by charts-pipeline).
# The pipeline programs/scripts themselves ARE tracked; only their output is not.
*.mbtiles
charts-pipeline/out/

# Build / run logs
*.log
build_log.txt

# Python screen-design mockups — reference material, deliberately untracked
simrad-mockup/
simrad-nav-mockup/
__pycache__/

# Root-level debug screenshots / session notes / UI dumps (app res + icon PNGs stay tracked)
/*.png
/state*.md
/ui.xml

# Local infrastructure — internal hosts/shares/credential locations; never publish.
# These live on disk (+ backup in ..\MyNavvy-infra-local) but stay out of git.
/REMOTE-BUILD-AND-LOGS.md
/TABLET-SETUP.md
/publish-mynavvy.ps1
/publish-mynavvy-data.ps1
