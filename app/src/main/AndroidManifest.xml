<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Detect "no signal at sea" so we fall back to cached data instantly instead of timing out. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- requestNetwork(TRANSPORT_WIFI): pin NMEA sockets to the boat's WiFi AP (no-internet
         networks otherwise route over cellular and silently fail). Normal permission. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- MulticastLock for GoFree discovery (239.2.1.1:2052) — Android drops multicast without it. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Anchor drag alarm buzzes the phone. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Anchor watch keeps running (GPS + drag alarm) while the app is minimised. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- CPU wake lock: with the screen off the CPU sleeps between GPS fixes, so the drag alarm would
         stop evaluating. Held only while a watch is armed, to keep GPS + drag detection alive. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Ask to exempt the app from Doze/battery optimisation — otherwise the OS freezes even a
         foreground service's wake lock + GPS once the device is idle, and the anchor alarm dies. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Exact, Doze-proof watchdog alarm that re-checks the boat's position even if continuous GPS
         updates are frozen by the OS. USE_EXACT_ALARM is auto-granted (an anchor drag alarm is a
         legitimate alarm use, and this app is sideloaded — no Play policy). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- In-app self-updater: download a newer APK and hand it to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- GPS is expected but not strictly required (tablet may use network location). -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:name=".MyNavvyApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.MyNavvy">

        <!-- Disable Sentry's auto-init ContentProvider; we init manually in
             MyNavvyApp/Diagnostics with the DSN from BuildConfig + custom options. -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MyNavvy.Starting"
            android:screenOrientation="fullUser"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Register MyNavvy as a target for shared locations (e.g. Google Maps "Share"). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- …and as a handler for geo: links. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BoatConfigActivity"
            android:exported="false"
            android:label="Boat"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Always-on GPS / anchor / track watch; keeps working when the app is minimised. -->
        <service
            android:name=".WatchService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Shares the diagnostics log file out via the Android share sheet. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- PackageInstaller status callbacks for the in-app self-updater. -->
        <receiver
            android:name=".AppInstallReceiver"
            android:exported="false" />
    </application>

</manifest>
