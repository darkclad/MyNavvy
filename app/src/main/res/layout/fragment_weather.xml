<?xml version="1.0" encoding="utf-8"?>
<!-- FrameLayout so the live clock can be pinned at the top (MENU's level) and stay put while the
     content ScrollView pans. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b0f13">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="58dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:text="Weather &amp; Tides" />

            <TextView
                android:id="@+id/tvWxStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:textColor="#9fb3c0"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:text="" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#8FA6B4"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:text="TIDE — 48 h (ft above MLLW)" />

            <com.dvladi.mynavvy.TideGraphView
                android:id="@+id/tideGraphFull"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#8FA6B4"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:text="NEXT TIDES" />

            <LinearLayout
                android:id="@+id/tideContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#8FA6B4"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:text="WIND AT BOAT" />

            <LinearLayout
                android:id="@+id/windContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical">
                <Button android:id="@+id/btnWxRefresh" style="@style/ChartTool"
                    android:layout_width="0dp" android:layout_weight="1.4"
                    android:text="Download offline data" />
                <Button android:id="@+id/btnWxChart" style="@style/ChartTool"
                    android:layout_width="0dp" android:layout_weight="1" android:text="Back to chart" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Live current-time clock — pinned top-right at the MENU button's level; ticks every second
         and does not scroll with the content. -->
    <TextView
        android:id="@+id/tvNowClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:elevation="4dp"
        android:textColor="#FF5A6E"
        android:textSize="22sp"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:text="--:--:--" />
</FrameLayout>
