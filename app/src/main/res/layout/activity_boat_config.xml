<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101418"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Boat configuration" android:textColor="#FFFFFF" android:textSize="20sp" />

        <TextView
            android:id="@+id/tvCurrent"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:paddingBottom="10dp"
            android:textColor="#8fd3ff" android:textSize="13sp" android:fontFamily="monospace"
            android:text="—" />

        <!-- Catalogue lookup -->
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Find your boat (offline catalogue)" android:textColor="#FFFFFF" android:textSize="14sp" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textColor="#9fb3c0" android:textSize="12sp"
            android:text="e.g. &quot;catalina 34 wing&quot; — pick the right KEEL: it sets your draft." />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:inputType="text"
                android:textColor="#FFFFFF" android:textColorHint="#7d8f9b"
                android:hint="Catalina 34 1992" android:importantForAutofill="no" />
            <Button
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Search" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/results"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingVertical="6dp" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginVertical="10dp" android:background="#33ffffff" />

        <!-- Safety-critical -->
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Used by the router" android:textColor="#FFFFFF" android:textSize="14sp" />

        <TextView android:id="@+id/tvDraftLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Draft (m)" android:textColor="#9fb3c0" android:textSize="12sp" android:layout_marginTop="6dp"/>
        <EditText android:id="@+id/etDraft" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberDecimal" android:textColor="#FFFFFF" android:importantForAutofill="no" />

        <TextView android:id="@+id/tvMarginLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Under-keel clearance margin (m)" android:textColor="#9fb3c0" android:textSize="12sp" />
        <EditText android:id="@+id/etMargin" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberDecimal" android:textColor="#FFFFFF" android:importantForAutofill="no" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Motoring cruise speed (kn)" android:textColor="#9fb3c0" android:textSize="12sp" />
        <EditText android:id="@+id/etCruise" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberDecimal" android:textColor="#FFFFFF" android:importantForAutofill="no" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginVertical="10dp" android:background="#33ffffff" />

        <!-- Descriptive -->
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Details" android:textColor="#FFFFFF" android:textSize="14sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Boat name" android:textColor="#9fb3c0" android:textSize="12sp" android:layout_marginTop="6dp"/>
        <EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="text" android:textColor="#FFFFFF" android:importantForAutofill="no" />

        <TextView android:id="@+id/tvAirDraftLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Air draft — mast height above water (m), for bridges" android:textColor="#9fb3c0" android:textSize="12sp" />
        <EditText android:id="@+id/etAirDraft" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberDecimal" android:textColor="#FFFFFF" android:importantForAutofill="no" />

        <TextView android:id="@+id/tvSpecs"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#9fb3c0" android:textSize="12sp" android:fontFamily="monospace"
            android:text="" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Save" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:paddingBottom="20dp"
            android:textColor="#7d8f9b" android:textSize="11sp"
            android:text="Draft + margin decide which water the weather router treats as navigable. Charted depths are a planning aid — always cross-check with your depth sounder." />
    </LinearLayout>
</ScrollView>
