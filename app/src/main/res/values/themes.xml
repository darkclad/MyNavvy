<resources>
    <style name="Theme.MyNavvy" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Cold-start splash (androidx core-splashscreen). Navy field + the boat icon, held on
         screen until the chart's first frame is ready — see MainActivity.installSplashScreen(). -->
    <style name="Theme.MyNavvy.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F1418</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MyNavvy</item>
    </style>

    <!-- Chartplotter data sidebar: small dim label, big bright value, tiny unit/source note. -->
    <style name="HudLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">#8FA6B4</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="HudValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="HudSmall">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- Chart control-bar button: compact, single line, minimal insets so 9 fit across.
         Borderless buttons inherit the (Light) theme's dark text, which is invisible on the dark
         bar — so force a light text colour. -->
    <style name="ChartTool" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingHorizontal">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#D6E0E6</item>
    </style>

    <!-- Left-side chart tool: an icon-only (glyph) button. -->
    <style name="ToolIcon" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">54dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textColor">#D6E0E6</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Menu icon tile (Simrad-style grid cell). -->
    <style name="MenuTile">
        <item name="android:layout_width">92dp</item>
        <item name="android:layout_height">84dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_menu_tile</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="MenuTileIcon">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
    </style>

    <style name="MenuTileLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">#C7D2DC</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Bottom-navigation tab button. -->
    <style name="NavTab" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#9fb3c0</item>
    </style>

    <style name="HudUnit">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#6F8593</item>
        <item name="android:textSize">9sp</item>
    </style>
</resources>
